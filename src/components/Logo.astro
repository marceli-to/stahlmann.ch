---
import Pulse from '../assets/icons/pulse.svg';
---

<a href="/" aria-label="Homepage" class="flex shrink-0 items-center gap-3.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pulse">
  <div class="relative size-11.5 shrink-0 rounded-[0.67rem] bg-ink-800">
    <Pulse class="absolute top-[0.2875rem] left-[0.2875rem]" aria-hidden="true" />
  </div>
  <div class="flex flex-col items-center gap-px whitespace-nowrap">
    <div class="font-display text-[1.6875rem] leading-none tracking-[-0.01em] text-fg-subtle">STAHLMANN</div>
    <div class="text-[0.6rem] leading-[1.1] font-semibold tracking-[0.14em] text-pulse">KONDITIONSTRAINER</div>
  </div>
</a>
