---
// Direction: "Premium coaching" – calm, centred, semibold sentence case with serif italic accents, soft glow, rounded bento cards.
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-training.jpg';
import portrait from '../../assets/images/portrait.jpg';
import badge from '../../assets/images/badge-patch.png';
import ChatDark from '../../assets/icons/chat-dark.svg';
import ChatLight from '../../assets/icons/chat-light.svg';
import Check from '../../assets/icons/check.svg';
import Clock from '../../assets/icons/clock.svg';
import Target from '../../assets/icons/target.svg';
import Shield from '../../assets/icons/shield.svg';
import Restart from '../../assets/icons/restart.svg';
import ClockFlex from '../../assets/icons/clock-flex.svg';
import { hero, stats, story, pillars, packages, pricingNote, contact } from '../../content';

const icons = [Target, Shield, Restart, ClockFlex];
const heading = 'font-sans font-semibold tracking-[-0.035em] text-balance';
const accent = 'font-serif font-normal tracking-normal text-pulse italic';
const card = 'rounded-3xl bg-ink-850 shadow-[inset_0_1px_0_rgb(255_255_255/0.05)] ring-1 ring-white/5';
const pill = 'inline-flex items-center justify-center gap-2.5 rounded-full px-7 py-4 text-base font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pulse';
const chip = 'inline-flex w-fit items-center gap-2 rounded-full bg-white/5 px-3.5 py-1.5 text-sm font-medium text-fg-muted ring-1 ring-white/10';
---

<!-- Hero -->
<section class="relative isolate overflow-hidden pt-16 pb-20 sm:pt-24 lg:pb-28">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-[40rem] bg-[radial-gradient(ellipse_50%_60%_at_50%_0%,rgb(91_196_106/0.18),transparent)]"></div>
  <div class="container-page flex flex-col items-center gap-14 text-center">
    <div class="flex flex-col items-center gap-7">
      <p class={chip}><span class="size-1.5 rounded-full bg-pulse"></span>{hero.eyebrow}</p>
      <h1 class:list={[heading, 'max-w-[58rem] text-[2.75rem]/[1.02] sm:text-6xl/[1] lg:text-[5.25rem]/[0.98]']}>
        Kondition, Sporttest-Vorbereitung &amp; mentale <span class={accent}>Stärke.</span>
      </h1>
      <p class="max-w-[40rem] text-lg/[1.6] text-fg-muted">{hero.lead}</p>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={hero.ctaHref} target="_blank" rel="noopener" class:list={[pill, 'bg-pulse text-pulse-ink hover:bg-[#6fd27d]']}><ChatDark aria-hidden="true" /> Kostenloses Erstgespräch</a>
        <a href="#angebot" class:list={[pill, 'bg-white/5 text-fg ring-1 ring-white/10 hover:bg-white/10']}>Angebot ansehen</a>
      </div>
    </div>
    <div class="relative w-full">
      <Image src={heroImage} alt="Thomas Stadelmann beim Training mit Battle Ropes in einer Industriehalle" widths={[600, 900, 1106]} sizes="(min-width: 1248px) 1200px, 100vw" loading="eager" class="aspect-4/3 w-full rounded-[2rem] object-cover object-[75%_30%] outline-1 -outline-offset-1 outline-white/10 sm:aspect-21/9" />
      <dl class="absolute inset-x-4 -bottom-10 mx-auto grid max-w-[56rem] grid-cols-2 gap-px overflow-hidden rounded-2xl bg-white/10 text-left ring-1 ring-white/10 backdrop-blur-xl max-sm:hidden lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="flex flex-col-reverse justify-end gap-1 bg-ink-900/80 px-5 py-4">
              <dt class="text-sm/[1.4] text-fg-muted">{stat.label}</dt>
              <dd class="text-2xl font-semibold tracking-[-0.03em] tabular-nums">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<!-- Stats for small screens (shown on the photo from sm up) -->
<section aria-label="Erfahrung in Zahlen" class="pb-16 sm:hidden">
  <dl class="container-page grid grid-cols-2 gap-3">
    {
      stats.map((stat) => (
        <div class:list={[card, 'flex flex-col-reverse justify-end gap-1 p-5']}>
          <dt class="text-base/[1.4] text-fg-muted">{stat.label}</dt>
          <dd class="text-2xl font-semibold tracking-[-0.03em] tabular-nums">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- Story: bento -->
<section id="story" class="overflow-x-clip py-20 sm:pt-32 lg:pb-28">
  <div class="container-page flex flex-col gap-12">
    <div class="flex flex-col items-center gap-5 text-center">
      <p class={chip}>Über mich</p>
      <h2 class:list={[heading, 'text-4xl/[1.05] sm:text-[3.5rem]/[1.02]']}>Thomas <span class={accent}>«Stahlmann»</span> Stadelmann</h2>
    </div>
    <div class="grid gap-4 lg:grid-cols-12">
      <div class="relative overflow-hidden rounded-3xl lg:col-span-5 lg:row-span-2">
        <Image src={portrait} alt="Thomas Stadelmann mit Gewichtsweste und Stahlmann-Patch" widths={[480, 720, 960]} sizes="(min-width: 1024px) 480px, 100vw" class="aspect-4/5 size-full object-cover object-[22%_50%] lg:aspect-auto" />
        <Image src={badge} alt="" widths={[200, 400]} sizes="144px" class="absolute right-4 bottom-4 size-36 rotate-8" />
      </div>
      <div class:list={[card, 'p-7 sm:p-10 lg:col-span-7']}>
        <p class="text-lg/[1.65] text-fg-muted sm:text-xl/[1.6]">{story.text}</p>
      </div>
      <dl class:list={[card, 'flex flex-col divide-y divide-white/5 px-7 sm:px-10 lg:col-span-7']}>
        {
          story.experience.map((item) => (
            <div class="flex flex-col gap-1.5 py-5 sm:flex-row sm:gap-6">
              <dt class="text-base font-semibold text-pulse sm:w-28 sm:shrink-0">{item.label}</dt>
              <dd class="text-base/[1.55]">{item.text}</dd>
            </div>
          ))
        }
      </dl>
      <div class:list={[card, 'flex items-center gap-5 bg-linear-to-br from-pulse-tint to-ink-850 p-7 sm:p-8 lg:col-span-12']}>
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-pulse/10"><Clock aria-hidden="true" /></div>
        <p class="text-base/[1.6] text-fg-muted">{story.flex}</p>
      </div>
    </div>
  </div>
</section>

<!-- Angebot -->
<section id="angebot" class="py-20 lg:py-28">
  <div class="container-page flex flex-col gap-12">
    <div class="flex flex-col items-center gap-5 text-center">
      <p class={chip}>Mein Angebot</p>
      <h2 class:list={[heading, 'text-4xl/[1.05] sm:text-[3.5rem]/[1.02]']}>Vier Säulen für deinen <span class={accent}>Erfolg</span></h2>
    </div>
    <ul role="list" class="grid gap-4 sm:grid-cols-2">
      {
        pillars.map((pillar, i) => {
          const Icon = icons[i];
          return (
            <li class:list={[card, 'flex flex-col gap-6 p-7 sm:p-10']}>
              <div class="flex size-14 items-center justify-center rounded-2xl bg-pulse/10 ring-1 ring-pulse/20">
                <Icon aria-hidden="true" />
              </div>
              <div class="flex flex-col gap-3">
                <h3 class="text-2xl/[1.2] font-semibold tracking-[-0.02em]">{pillar.title}</h3>
                <p class="text-base/[1.6] text-fg-muted">{pillar.text}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<!-- Preise -->
<section id="preise" class="py-20 lg:py-28">
  <div class="container-page flex flex-col gap-12">
    <div class="flex flex-col items-center gap-5 text-center">
      <p class={chip}>Preise &amp; Pakete</p>
      <h2 class:list={[heading, 'text-4xl/[1.05] sm:text-[3.5rem]/[1.02]']}>Wähle deine <span class={accent}>Mission</span></h2>
    </div>
    <ul role="list" class="mx-auto grid w-full max-w-xl gap-4 lg:max-w-none lg:grid-cols-3 lg:items-stretch">
      {
        packages.map((pkg) => (
          <li
            class:list={[
              'flex flex-col justify-between gap-10 rounded-3xl p-8 sm:p-9',
              pkg.featured
                ? 'bg-ink-850 shadow-[0_0_80px_-24px_var(--color-pulse)] ring-2 ring-pulse'
                : card,
            ]}
          >
            <div class="flex flex-col gap-6">
              <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-semibold text-pulse">{pkg.tag}</p>
                {pkg.featured && <p class="rounded-full bg-pulse px-3 py-1 text-xs font-semibold text-pulse-ink">Beliebt</p>}
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-2xl/[1.2] font-semibold tracking-[-0.02em]">{pkg.title}</h3>
                <p class="text-base text-fg-subtle sm:text-sm">{pkg.audience}</p>
              </div>
              <div class="flex flex-col gap-1">
                <p class="text-[2.75rem]/[1] font-semibold tracking-[-0.04em] tabular-nums">{pkg.price}</p>
                <p class="text-sm text-fg-muted">{pkg.priceNote}</p>
              </div>
              <ul role="list" class="flex flex-col gap-3 border-t border-white/5 pt-6">
                {pkg.features.map((feature) => (
                  <li class="flex gap-3 text-base/[1.45] sm:text-[0.9375rem]/[1.45]">
                    <Check class="h-lh shrink-0" aria-hidden="true" />
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={pkg.href}
              target="_blank"
              rel="noopener"
              class:list={[pill, 'w-full', pkg.featured ? 'bg-pulse text-pulse-ink hover:bg-[#6fd27d]' : 'bg-white/5 text-fg ring-1 ring-white/10 hover:bg-white/10']}
            >
              {pkg.featured ? <ChatDark aria-hidden="true" /> : <ChatLight aria-hidden="true" />} Via WhatsApp anfragen
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-center text-sm/[1.5] text-fg-subtle">{pricingNote}</p>
  </div>
</section>

<!-- Kontakt -->
<section id="kontakt" class="pt-8 pb-20 lg:pb-28">
  <div class="container-page">
    <div class:list={[card, 'relative isolate flex flex-col items-center gap-8 overflow-hidden px-6 py-16 text-center sm:px-12 lg:py-24']}>
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_70%_at_50%_100%,rgb(91_196_106/0.22),transparent)]"></div>
      <h2 class:list={[heading, 'max-w-[48rem] text-[2.5rem]/[1.02] sm:text-6xl/[1] lg:text-[4.5rem]/[0.98]']}>Bereit für das nächste <span class={accent}>Level?</span></h2>
      <p class="max-w-[36rem] text-lg/[1.6] text-fg-muted">{contact.text}</p>
      <a href={contact.href} target="_blank" rel="noopener" class:list={[pill, 'w-full bg-pulse px-9 py-5 text-lg text-pulse-ink hover:bg-[#6fd27d] sm:w-auto']}><ChatDark aria-hidden="true" /> {contact.cta}</a>
    </div>
  </div>
</section>
