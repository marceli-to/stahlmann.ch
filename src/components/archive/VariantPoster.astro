---
// Direction: "Poster campaign" – full-bleed photo hero, expanded caps, green ticker + colour blocks, pill buttons.
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-training.jpg';
import portrait from '../../assets/images/portrait.jpg';
import badge from '../../assets/images/badge-patch.png';
import ChatDark from '../../assets/icons/chat-dark.svg';
import ChatLight from '../../assets/icons/chat-light.svg';
import Check from '../../assets/icons/check.svg';
import { hero, stats, story, pillars, packages, pricingNote, contact, disciplines } from '../../content';

const expanded = 'font-sans font-black font-stretch-125% uppercase';
const pill = 'inline-flex items-center justify-center gap-2.5 rounded-full px-7 py-4.5 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pulse';
---

<!-- Hero: full-bleed photo -->
<section class="relative isolate flex min-h-[calc(100svh-5rem)] items-end overflow-hidden">
  <Image src={heroImage} alt="" widths={[800, 1106]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 size-full object-cover object-[75%_50%]" />
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink-900 via-ink-900/70 to-ink-900/20 lg:bg-linear-to-r lg:from-ink-900 lg:via-ink-900/75 lg:to-transparent"></div>
  <div class="container-page flex flex-col items-start gap-7 pt-32 pb-14 lg:pb-20">
    <p class="rounded-full bg-pulse px-4 py-2 text-xs font-bold tracking-[0.14em] text-pulse-ink uppercase">{hero.eyebrow}</p>
    <h1 class:list={[expanded, 'max-w-[54rem] text-[1.875rem]/[0.98] tracking-[-0.02em] sm:text-6xl/[0.92] lg:text-[5rem]/[0.9]']}>{hero.title}</h1>
    <p class="max-w-[36rem] text-lg/[1.55] text-fg">{hero.lead}</p>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href={hero.ctaHref} target="_blank" rel="noopener" class:list={[pill, 'bg-pulse text-pulse-ink hover:bg-[#6fd27d]']}><ChatDark aria-hidden="true" /> Kostenloses Erstgespräch</a>
      <a href="#angebot" class:list={[pill, 'bg-white/10 text-fg backdrop-blur hover:bg-white/20']}>Angebot ansehen</a>
    </div>
  </div>
</section>

<!-- Ticker -->
<div aria-hidden="true" class="overflow-hidden bg-pulse py-4 text-pulse-ink">
  <div class="flex w-max animate-marquee motion-reduce:animate-none">
    {
      [0, 1].map(() => (
        <div class:list={[expanded, 'flex shrink-0 items-center gap-8 pr-8 text-xl tracking-[0.02em]']}>
          {disciplines.map((item) => (
            <>
              <span>{item}</span>
              <span class="size-2 rounded-full bg-pulse-ink" />
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>

<!-- Stats -->
<section aria-label="Erfahrung in Zahlen" class="py-16 lg:py-24">
  <dl class="container-page grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="flex flex-col-reverse justify-end gap-3">
          <dt class="text-base/[1.45] text-fg-muted">{stat.label}</dt>
          <dd class:list={[expanded, 'text-[1.375rem]/[1] text-pulse tabular-nums sm:text-[2.25rem]/[1] lg:whitespace-nowrap xl:text-[2.5rem]/[1]']}>{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- Story -->
<section id="story" class="overflow-x-clip py-16 lg:py-28">
  <div class="container-page grid items-center gap-16 lg:grid-cols-2 lg:gap-20">
    <div class="flex flex-col gap-8 lg:order-last">
      <p class="w-fit rounded-full border border-line px-4 py-2 text-xs font-bold tracking-[0.14em] text-pulse uppercase">Über mich</p>
      <h2 class:list={[expanded, 'text-[1.75rem]/[0.98] sm:text-5xl/[0.95]']}>{story.name}</h2>
      <p class="text-lg/[1.6] text-fg-muted">{story.text}</p>
      <ul role="list" class="flex flex-col gap-3">
        {
          story.experience.map((item) => (
            <li class="flex flex-col gap-1 rounded-2xl bg-ink-850 p-5 sm:flex-row sm:gap-5">
              <p class="text-base font-bold text-pulse sm:w-28 sm:shrink-0">{item.label}</p>
              <p class="text-base/[1.55]">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="relative mx-auto w-full max-w-[30rem]">
      <Image src={portrait} alt="Thomas Stadelmann mit Gewichtsweste und Stahlmann-Patch" widths={[480, 720, 960]} sizes="(min-width: 1024px) 480px, 100vw" class="aspect-3/4 w-full rounded-[2rem] object-cover object-[22%_50%]" />
      <div class:list={[expanded, 'absolute -right-3 -bottom-6 rounded-full bg-pulse px-5 py-3 text-sm text-pulse-ink sm:-right-8']}>Flexibel · Antizyklisch</div>
      <Image src={badge} alt="" widths={[200, 400]} sizes="160px" class="absolute -top-8 -left-6 size-36 -rotate-12 sm:-left-12 sm:size-40" />
    </div>
  </div>
</section>

<!-- Angebot: numbered rows -->
<section id="angebot" class="py-16 lg:py-28">
  <div class="container-page flex flex-col gap-12">
    <div class="flex flex-col gap-5">
      <p class="w-fit rounded-full border border-line px-4 py-2 text-xs font-bold tracking-[0.14em] text-pulse uppercase">Mein Angebot</p>
      <h2 class:list={[expanded, 'text-[2.25rem]/[0.95] sm:text-6xl/[0.92]']}>Vier Säulen für deinen Erfolg</h2>
    </div>
    <ol class="flex flex-col border-b border-line">
      {
        pillars.map((pillar, i) => (
          <li class="grid gap-3 border-t border-line py-8 lg:grid-cols-[6rem_1fr_1fr] lg:items-baseline lg:gap-10">
            <p class:list={[expanded, 'text-lg text-pulse']}>0{i + 1}</p>
            <h3 class:list={[expanded, 'text-2xl/[1.05] sm:text-[2rem]/[1.05]']}>{pillar.title}</h3>
            <p class="text-base/[1.6] text-fg-muted">{pillar.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Preise -->
<section id="preise" class="py-16 lg:py-28">
  <div class="container-page flex flex-col gap-12">
    <div class="flex flex-col gap-5">
      <p class="w-fit rounded-full border border-line px-4 py-2 text-xs font-bold tracking-[0.14em] text-pulse uppercase">Preise &amp; Pakete</p>
      <h2 class:list={[expanded, 'text-[2.25rem]/[0.95] sm:text-6xl/[0.92]']}>Wähle deine Mission</h2>
    </div>
    <ul role="list" class="mx-auto grid w-full max-w-xl gap-5 lg:max-w-none lg:grid-cols-3">
      {
        packages.map((pkg) => (
          <li class:list={['flex flex-col justify-between gap-10 rounded-[2rem] p-6 sm:p-8', pkg.featured ? 'bg-pulse text-pulse-ink' : 'border-2 border-line']}>
            <div class="flex flex-col gap-5">
              <p class:list={['text-xs font-bold tracking-[0.14em] uppercase', pkg.featured ? 'text-pulse-ink/70' : 'text-pulse']}>{pkg.tag}</p>
              <h3 class:list={[expanded, 'text-2xl/[1.05]']}>{pkg.title}</h3>
              <p class:list={['text-base', pkg.featured ? 'text-pulse-ink/70' : 'text-fg-subtle']}>{pkg.audience}</p>
              <div class="flex flex-col gap-1">
                <p class:list={[expanded, 'text-[1.75rem]/[1] tabular-nums sm:text-[2.5rem]/[1]']}>{pkg.price}</p>
                <p class:list={['text-sm font-semibold', pkg.featured ? 'text-pulse-ink/70' : 'text-fg-muted']}>{pkg.priceNote}</p>
              </div>
              <ul role="list" class="flex flex-col gap-2.5 text-base/[1.45]">
                {pkg.features.map((feature) => (
                  <li class="flex gap-3">
                    {pkg.featured ? (
                      <svg class="h-lh w-4.5 shrink-0" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3.75 9.375L7.125 12.75L14.25 5.625" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    ) : (
                      <Check class="h-lh shrink-0" aria-hidden="true" />
                    )}
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={pkg.href}
              target="_blank"
              rel="noopener"
              class:list={[pill, pkg.featured ? 'bg-pulse-ink text-fg hover:bg-ink-800' : 'bg-white/8 text-fg hover:bg-white/15']}
            >
              <ChatLight aria-hidden="true" /> Via WhatsApp anfragen
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-sm/[1.5] text-fg-subtle">{pricingNote}</p>
  </div>
</section>

<!-- Kontakt: green block -->
<section id="kontakt" class="bg-pulse text-pulse-ink">
  <div class="container-page flex flex-col items-start gap-8 py-20 lg:py-28">
    <h2 class:list={[expanded, 'max-w-[60rem] text-[2.75rem]/[0.92] sm:text-7xl/[0.9] lg:text-[6rem]/[0.88]']}>{contact.title}</h2>
    <p class="max-w-[36rem] text-xl/[1.5] font-medium">{contact.text}</p>
    <a href={contact.href} target="_blank" rel="noopener" class:list={[pill, 'w-full bg-pulse-ink px-9 py-5.5 text-lg text-fg hover:bg-ink-800 sm:w-auto']}><ChatLight aria-hidden="true" /> {contact.cta}</a>
  </div>
</section>
