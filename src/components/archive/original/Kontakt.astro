---
import Button from './Button.astro';
import PulseCta from '../../../assets/icons/pulse-cta.svg';
import { whatsappLink } from '../../../site';
---

<section id="kontakt" class="py-20 sm:py-28 lg:py-32">
  <div class="container-page flex flex-col items-center gap-8 text-center">
    <PulseCta class="h-auto w-48 sm:w-60" aria-hidden="true" />
    <h2 class="max-w-[56.25rem] font-display text-[2.5rem]/[1.05] tracking-[-0.02em] text-balance sm:text-6xl/[1.05] lg:text-[4rem]/[1.05]">
      Bereit für das nächste Level?
    </h2>
    <p class="max-w-[40rem] text-lg/[1.55] text-fg-muted sm:text-xl/[1.55]">
      Vergiss Ausreden. Schreib mir direkt auf WhatsApp – das erste Beratungsgespräch ist kostenlos.
    </p>
    <div class="w-full pt-2 sm:w-auto">
      <Button href={whatsappLink('Hallo Thomas, ich bin bereit für das nächste Level!')} size="xl" icon external class="w-full sm:w-auto">
        Jetzt starten – WhatsApp-Nachricht senden
      </Button>
    </div>
  </div>
</section>
