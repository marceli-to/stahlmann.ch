---
const stats = [
  { value: '15 Jahre', label: 'Sicherheitsbehörde (Polizei)' },
  { value: '2×', label: 'Auslandseinsatz NATO, Spezialinfanterie' },
  { value: '30+ Jahre', label: 'Leistungssport: Football, Ironman, Marathon' },
  { value: 'Aktuell', label: 'Feuerwehr, Intervention' },
];
---

<section aria-label="Erfahrung in Zahlen" class="pt-10 pb-20 lg:pb-24">
  <dl class="container-page grid grid-cols-2 gap-y-10 lg:grid-cols-4">
    {
      stats.map((stat, i) => (
        <div
          class:list={[
            'flex flex-col-reverse justify-end gap-2 pr-4 sm:pr-6',
            i % 2 === 1 && 'border-l border-line pl-5 sm:pl-8',
            i === 2 && 'lg:border-l lg:border-line lg:pl-8',
          ]}
        >
          <dt class="max-w-[14.375rem] text-base/[1.45] text-fg-muted sm:text-[0.9375rem]/[1.45]">{stat.label}</dt>
          <dd class="font-display text-[1.75rem] tracking-[-0.01em] tabular-nums sm:text-[2.5rem]">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
