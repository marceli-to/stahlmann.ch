---
import { Image } from 'astro:assets';
import Brackets from '../Brackets.astro';
import SectionBar from '../SectionBar.astro';
import portrait from '../../assets/images/portrait.jpg';
import badge from '../../assets/images/badge-patch.png';
import { story } from '../../content';
---

<section id="story" class="overflow-x-clip border-b border-line">
  <div class="container-page">
    <SectionBar index="01" title="Über mich" meta="Personalakte" />
    <div class="grid border-x border-line lg:grid-cols-12">
      <div class="relative p-8 sm:p-12 lg:col-span-5 lg:border-r lg:border-line">
        <div class="relative mx-auto max-w-[24rem]">
          <Brackets />
          <Image
            src={portrait}
            alt="Thomas Stadelmann mit Gewichtsweste und Stahlmann-Patch"
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 384px, 90vw"
            class="aspect-4/5 w-full object-cover object-[22%_50%]"
          />
          <Image src={badge} alt="" widths={[200, 400]} sizes="160px" class="absolute -right-6 -bottom-8 z-20 size-40 rotate-8" />
        </div>
      </div>
      <div class="flex flex-col gap-8 px-5 py-12 sm:px-8 lg:col-span-7 lg:px-14 lg:py-16">
        <p class="font-display text-[2.25rem]/[1] tracking-[-0.015em] uppercase sm:text-5xl/[1]">{story.name}</p>
        <p class="text-lg/[1.6] text-fg-muted">{story.text}</p>
        <dl class="border-t border-line">
          {
            story.experience.map((item) => (
              <div class="grid gap-2 border-b border-line py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <dt class="font-mono text-xs/6 tracking-[0.14em] text-pulse uppercase">{item.label}</dt>
                <dd class="text-base/[1.55]">{item.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="border-l-2 border-pulse pl-5 text-base/[1.55] text-fg-muted sm:text-[0.9375rem]/[1.55]">
          <span class="font-mono text-xs tracking-[0.14em] text-pulse uppercase">Hinweis: </span>{story.flex}
        </p>
      </div>
    </div>
  </div>
</section>
