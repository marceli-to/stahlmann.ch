---
import Divider from '../../assets/icons/pulse-divider.svg';
---

<!-- The 1440px-wide line keeps its proportions; narrower screens crop the flat ends, the beat stays centred. -->
<div class="relative h-22.5 overflow-hidden" aria-hidden="true">
  <Divider class="absolute top-0 left-1/2 h-22.5 w-full min-w-[1440px] -translate-x-1/2" />
</div>
