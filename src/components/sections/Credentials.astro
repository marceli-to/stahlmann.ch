---
import { stats } from '../../content';
---

<section aria-label="Erfahrung in Zahlen" class="border-b border-line">
  <div class="container-page">
    <dl class="grid grid-cols-2 gap-px border-x border-line bg-line lg:grid-cols-4">
      {
        stats.map((stat, i) => (
          <div class="flex flex-col-reverse justify-end gap-3 bg-ink-900 px-5 py-8 sm:px-8">
            <dt class="text-base/[1.45] text-fg-muted sm:text-sm/[1.45]">{stat.label}</dt>
            <dd class="font-display text-[1.75rem] tracking-[-0.01em] uppercase tabular-nums sm:text-4xl lg:text-[1.875rem] xl:text-4xl">{stat.value}</dd>
            <dd aria-hidden="true" class="font-mono text-xs tracking-[0.12em] text-pulse">[0{i + 1}]</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
