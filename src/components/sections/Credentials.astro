---
import { stats } from '../../content';
---

<section aria-label="Erfahrung in Zahlen" class="border-b border-line">
  <div class="container-page">
    <dl class="grid grid-cols-2 gap-px border-x border-line bg-line lg:grid-cols-4">
      {
        stats.map((stat, i) => (
          <div class="flex flex-col-reverse justify-end gap-3 bg-ink-900 px-4 py-8 min-[400px]:px-5 sm:px-8">
            <dt class="text-[0.9375rem]/[1.45] text-fg-muted hyphens-auto [overflow-wrap:anywhere] sm:text-sm/[1.45]">{stat.label}</dt>
            <dd class="font-display text-[1.375rem]/[1.1] tracking-[-0.01em] uppercase min-[400px]:text-2xl/[1.1] tabular-nums sm:text-4xl/[1.1] lg:text-[1.875rem]/[1.1] xl:text-4xl/[1.1]">{stat.value}</dd>
            <dd aria-hidden="true" class="font-mono text-xs tracking-[0.12em] text-pulse">[0{i + 1}]</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
