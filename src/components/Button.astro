---
import ChatDark from '../assets/icons/chat-dark.svg';
import ChatLight from '../assets/icons/chat-light.svg';

interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  size?: 'sm' | 'md';
  icon?: boolean;
  /** Decorative arrow after (→) or before (←) the label; hidden from screen readers. */
  arrow?: 'right' | 'left';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', icon = false, arrow, external = false, class: className } = Astro.props;

const sizes = {
  sm: 'gap-2.5 px-4 py-3 text-xs',
  md: 'gap-3 px-6 py-4.5 text-sm',
};

const variants = {
  primary: 'bg-pulse text-pulse-ink hover:bg-[#6fd27d]',
  outline: 'border border-fg-subtle text-fg hover:border-fg hover:bg-white/5',
};

const Icon = variant === 'primary' ? ChatDark : ChatLight;
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
  class:list={[
    'inline-flex items-center justify-center text-center font-mono font-semibold tracking-[0.08em] uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pulse',
    sizes[size],
    variants[variant],
    className,
  ]}
>
  {icon && <Icon class="shrink-0" aria-hidden="true" />}
  {arrow === 'left' && <span aria-hidden="true">←</span>}
  <span><slot />{external && <span class="sr-only"> (öffnet in neuem Fenster)</span>}</span>
  {arrow === 'right' && <span aria-hidden="true">→</span>}
</a>
