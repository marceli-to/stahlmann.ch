---
import ChatDark from '../assets/icons/chat-dark.svg';
import ChatLight from '../assets/icons/chat-light.svg';

interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  icon?: boolean;
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', icon = false, external = false, class: className } = Astro.props;

// Sizes taken from the Figma buttons: header (sm), package (md), hero (lg), CTA (xl)
const sizes = {
  sm: 'px-5.5 py-3.5 text-[0.9375rem]',
  md: 'px-5.5 py-3.5 text-base',
  lg: 'px-8 py-5 text-[1.0625rem]',
  xl: 'px-7 py-5 text-[1.0625rem] sm:px-9 sm:py-5.5 sm:text-[1.1875rem]',
};

const variants = {
  primary: 'bg-pulse text-pulse-ink hover:bg-[#6fd27d]',
  outline: 'border-[1.5px] border-fg-subtle text-fg hover:border-fg hover:bg-white/5',
};

const Icon = variant === 'primary' ? ChatDark : ChatLight;
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-lg text-center leading-none font-bold tracking-[0.01em] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pulse',
    sizes[size],
    variants[variant],
    className,
  ]}
>
  {icon && <Icon class="shrink-0" aria-hidden="true" />}
  <slot />
</a>
