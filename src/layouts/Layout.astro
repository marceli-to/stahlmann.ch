---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, INSTAGRAM_URL, whatsappLink } from '../site';
import { packages } from '../content';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} – ${SITE.name}` : `${SITE.name} – Kondition, Sporttest-Vorbereitung & mentale Stärke`;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.jpg', site);
const ogImageAlt = 'Stahlmann Konditionstrainer – Kondition, Sporttest-Vorbereitung & mentale Stärke';
const isHome = Astro.url.pathname === '/';

// Structured data for search engines (homepage only). Address is added once the Impressum details are final.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: SITE.name,
      inLanguage: 'de-CH',
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${site.href}#business`,
      name: SITE.name,
      description: SITE.description,
      url: site.href,
      image: ogImage.href,
      logo: new URL('/favicon.svg', site).href,
      areaServed: ['Zürich', 'Aargau', 'Zug'].map((name) => ({ '@type': 'AdministrativeArea', name })),
      priceRange: 'CHF 135–1450',
      sameAs: [INSTAGRAM_URL],
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', url: whatsappLink(), availableLanguage: ['de'] },
      founder: { '@type': 'Person', name: SITE.owner, jobTitle: 'Konditionstrainer' },
      makesOffer: packages.map((pkg) => ({
        '@type': 'Offer',
        name: pkg.title,
        description: `${pkg.audience}. ${pkg.features.join(', ')}.`,
        price: pkg.price.replace(/[^\d]/g, ''),
        priceCurrency: 'CHF',
        url: pkg.href,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="de-CH" class="bg-ink-900 font-sans text-fg antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.owner} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#121416" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-100 bg-pulse px-4 py-3 font-mono text-xs font-semibold tracking-[0.1em] text-pulse-ink uppercase focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Zum Inhalt springen
    </a>
    <div class="isolate flex min-h-dvh flex-col overflow-x-clip">
      <Header />
      <main id="main" tabindex="-1" class="grow focus:outline-none">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
